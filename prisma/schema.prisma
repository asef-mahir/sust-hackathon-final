datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RiskStatus {
  SAFE
  WARNING
  CRITICAL
}

enum ProviderCode {
  BKASH
  NAGAD
  ROCKET
}

enum TransactionType {
  CASH_IN
  CASH_OUT
  // Added to support operational cash management scenarios
  LIQUIDITY_REFILL 
  PROVIDER_SETTLEMENT
}

enum ScenarioType {
  HIDDEN_SHORTAGE
  HIGH_VELOCITY
  DATA_INCONSISTENCY
  PHYSICAL_CASH_EXHAUSTION
  COORDINATED_CLOSURE
  NEGATIVE_BALANCE
}

enum AlertStatus {
  PENDING
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum AlertSource {
  RULE_BASED
  HYBRID
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

// 1. Add this enum at the top with your other enums
enum AreaProfile {
  CASH_IN_DOMINANT
  CASH_OUT_DOMINANT
  BALANCED
}

// 2. Replace your existing Area model with this updated version
model Area {
  id      String      @id @default(cuid())
  name    String      @unique
  profile AreaProfile @default(BALANCED) // New classification field
  agents  Agent[]
}

model Provider {
  id           String            @id @default(cuid())
  code         ProviderCode      @unique
  name         String
  balances     ProviderBalance[]
  alerts       Alert[]
  transactions Transaction[]
}

model Agent {
  id           String     @id @default(cuid())
  name         String
  outletCode   String     @unique
  areaId       String
  area         Area       @relation(fields: [areaId], references: [id], onDelete: Restrict)
  latitude     Float?
  longitude    Float?
  physicalCash Decimal    @default(0) @db.Decimal(12, 2)
  riskStatus   RiskStatus @default(SAFE) 
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  manager      Owner?

  balances       ProviderBalance[]
  transactions   Transaction[]
  alerts         Alert[]
  // Fixed casing here
  simulationRuns SimulationRun[]

  // Indexes for mapping dashboards and risk summaries
  @@index([riskStatus])
  @@index([areaId])
}

model ProviderBalance {
  id               String   @id @default(cuid())
  agentId          String
  providerId       String
  balance          Decimal  @default(0) @db.Decimal(12, 2)
  // Added threshold to easily flag 'HIDDEN_SHORTAGE' (Scenario A)
  minimumThreshold Decimal  @default(5000) @db.Decimal(12, 2) 
  updatedAt        DateTime @updatedAt

  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([agentId, providerId])
  @@index([providerId])
  // Index to quickly find balances dipping below safe thresholds
  @@index([balance]) 
}

model Transaction {
  id                 String          @id @default(cuid())
  agentId            String
  agent              Agent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  providerId         String
  provider           Provider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  
  // Added to track velocity from repeated actors (Scenario B)
  // Must use synthetic data per hackathon rules
  syntheticAccountId String?         

  type               TransactionType
  amount             Decimal         @db.Decimal(12, 2)
  isLate             Boolean         @default(false)
  isConflicting      Boolean         @default(false)
  timestamp          DateTime        @default(now())

  // Compound indexes for fast time-window queries and anomaly detection scripts
  @@index([agentId, timestamp])
  @@index([providerId, timestamp])
  @@index([syntheticAccountId, timestamp])
}

model Owner {
  // Added default generator
  id             String  @id @default(cuid()) 
  name           String
  role           String 

  managedAgentId String? @unique 
  managedAgent   Agent?  @relation(fields: [managedAgentId], references: [id], onDelete: SetNull)

  simulationRuns SimulationRun[]

  ownedAlerts    Alert[]      @relation("AlertOwner")
  alertEvents    AlertEvent[] @relation("EventActor")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Alerts + audit
// ---------------------------------------------------------------------------

model Alert {
  id               String          @id @default(cuid())
  agentId          String
  agent            Agent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  providerId       String?
  provider         Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  scenarioType     ScenarioType
  source           AlertSource     @default(RULE_BASED)
  
  // JSON stores detailed anomaly evidence, reasoning, and context for explainability 
  evidence         Json            
  explanations     Json?           
  
  confidence       ConfidenceLevel @default(MEDIUM)
  confidenceReason String?
  status           AlertStatus     @default(PENDING)
  ownerId          String?
  owner            Owner?          @relation("AlertOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?
  createdAt        DateTime        @default(now())
  resolvedAt       DateTime?

  events AlertEvent[]

  // Optimizes dashboard loading: sorting by recent, filtering by status/owner
  @@index([agentId, status])
  @@index([status])
  @@index([scenarioType])
  @@index([ownerId, status])
  @@index([createdAt])
}

model AlertEvent {
  id         String       @id @default(cuid())
  alertId    String
  alert      Alert        @relation(fields: [alertId], references: [id], onDelete: Cascade)
  fromStatus AlertStatus?
  toStatus   AlertStatus?
  actorId    String
  actor      Owner        @relation("EventActor", fields: [actorId], references: [id], onDelete: Restrict)
  note       String?
  timestamp  DateTime     @default(now())

  // Fast retrieval of audit trail for a specific alert
  @@index([alertId, timestamp])
  @@index([actorId])
}

model SimulationRun {
  id                  String       @id @default(cuid())
  scenarioType        ScenarioType
  agentId             String
  agent               Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  seed                Int?
  transactionsCreated Int
  alertsCreated       Int
  alertsSuppressed    Int
  durationMs          Int
  triggeredById       String
  triggeredBy         Owner        @relation(fields: [triggeredById], references: [id], onDelete: Restrict)
  createdAt           DateTime     @default(now())

  @@index([agentId, createdAt])
  @@index([triggeredById])
}